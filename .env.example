# Non-secret defaults. Copy this file to `.env`, then append the three credentials
# your interviewer pastes in chat at the start of the interview.
#
#   cp .env.example .env
#   cat >> .env <<'EOF'
#   MURAL_API_KEY=...
#   MURAL_TRANSFER_API_KEY=...
#   MURAL_SOURCE_ACCOUNT_ID=...
#   EOF

# --- Database ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/contractor_pay?schema=public"

# --- Server ---
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# --- Mural API ---
MURAL_API_BASE_URL=https://api-staging.muralpay.com

# Optional. Only set if your API key is scoped to a parent organization and you
# need to act on behalf of a child org. Most candidates will leave this unset.
# MURAL_ON_BEHALF_OF_ORG_ID=
