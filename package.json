{
  "name": "contractor-pay",
  "version": "0.1.0",
  "private": true,
  "description": "Backend that wraps Mural Pay's Payouts API for B2B contractor disbursement.",
  "scripts": {
    "bootstrap": "bash scripts/bootstrap.sh",
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "doctor": "tsx scripts/doctor.ts",
    "reset-org": "tsx scripts/reset-org.ts",
    "check-balance": "tsx scripts/check-balance.ts",
    "list-banks": "tsx scripts/list-banks.ts",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma db push --force-reset --skip-generate --accept-data-loss && tsx prisma/seed.ts",
    "prisma:generate": "prisma generate",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "decimal.js": "^10.4.3",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.0",
    "@types/supertest": "^6.0.2",
    "prisma": "^5.22.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
